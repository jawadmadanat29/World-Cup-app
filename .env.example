# ----------------------------------------------------------------------------
# World Cup Predictor 2026 — environment variables
# Copy this file to `.env` and adjust as needed.
# ----------------------------------------------------------------------------

# Database connection string.
# LOCAL DEV (default): SQLite file, zero external services.
DATABASE_URL="file:./dev.db"
#
# PRODUCTION / SUPABASE: switch `provider` to "postgresql" in prisma/schema.prisma,
# then paste your Supabase connection string here, e.g.:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Admin login password (the only secret needed to manage the league).
# CHANGE THIS before deploying.
ADMIN_PASSWORD="worldcup2026"

# Secret used to sign admin + participant session cookies. Any long random string.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-to-a-long-random-string"

# ----------------------------------------------------------------------------
# Live football-data API (OPTIONAL). Leave blank to run in manual mode — the
# app works fully without it; you just enter results yourself. When set, the
# admin "API Sync" console + /api/sync can pull live fixtures & results.
# Default target is API-Football (API-Sports) v3.
# ----------------------------------------------------------------------------
FOOTBALL_API_KEY=""
# FOOTBALL_API_HOST="v3.football.api-sports.io"   # RapidAPI: "api-football-v1.p.rapidapi.com"
# FOOTBALL_API_LEAGUE="1"                          # 1 = FIFA World Cup
# FOOTBALL_API_SEASON="2026"

# Shared secret for the /api/sync scheduler endpoint (Vercel Cron, etc.).
# Call: GET /api/sync  with header  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
